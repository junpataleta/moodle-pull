{
  "manifest_version": 3,

  "name": "Pull - Moodle Integration",
  "description": "A simple browser extension that generates git pull commands from the Moodle Tracker for Moodle integrators.",
  "version": "1.0.0",

  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup/popup.html"
  },

  "permissions": [
    "scripting",
    "activeTab",
    "clipboardWrite",
    "storage"
  ],

  "host_permissions": [
    "https://tracker.moodle.org/browse/MDL-*"
  ],

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "moodle-pull@junpataleta.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
